#!/usr/bin/env python3
"""Inspect the real site with your own login data. Prints a REDACTED shape only.

Usage:
    scripts/probe            # then paste your cURL / Cookie header, end with Ctrl-D
    scripts/probe --sso      # additionally test silent SSO re-login

Nothing is stored. Only key names, types, counts and HTTP metadata are printed,
never values, so the output is safe to share in an issue.

Only needs aiohttp (pip install aiohttp); Home Assistant is not required.
"""

from __future__ import annotations

import asyncio
import importlib.util
import os
from pathlib import Path
import sys
from typing import Any

try:
    import aiohttp
except ModuleNotFoundError:
    # Started with a Python without aiohttp (e.g. the system python3 via the
    # shebang): re-run with the repository's virtualenv if there is one.
    _venv_python = Path(__file__).resolve().parent.parent / ".venv" / "bin" / "python"
    if _venv_python.exists() and Path(sys.executable).resolve() != _venv_python.resolve():
        os.execv(str(_venv_python), [str(_venv_python), *sys.argv])
    sys.exit(
        "aiohttp is not installed. Run scripts/setup first, or: python3 -m pip install aiohttp"
    )

API_PATH = (
    Path(__file__).resolve().parent.parent
    / "custom_components"
    / "afvalcontainer_antwerpen"
    / "api.py"
)
_spec = importlib.util.spec_from_file_location("afv_api", API_PATH)
api = importlib.util.module_from_spec(_spec)  # type: ignore[arg-type]
sys.modules["afv_api"] = api
_spec.loader.exec_module(api)  # type: ignore[union-attr]


def shape(node: Any, depth: int = 0, max_depth: int = 4) -> Any:
    """Replace values by their type, keep structure."""
    if depth > max_depth:
        return "…"
    if isinstance(node, dict):
        return {k: shape(v, depth + 1, max_depth) for k, v in node.items()}
    if isinstance(node, list):
        return [f"list[{len(node)}]", shape(node[0], depth + 1, max_depth)] if node else "list[0]"
    if isinstance(node, bool) or node is None:
        return node
    return type(node).__name__


def label(name: str) -> str:
    """Cookie name without the remember-me hash suffix."""
    return "remember_*" if api.is_remember_cookie(name) else name


def pasted_lifetimes(text: str) -> dict[str, str] | None:
    """Remaining lifetime per cookie in cookie-editor JSON export(s) (names only)."""
    import time  # noqa: PLC0415

    items = api.iter_json_cookies(text.strip())
    if not items:
        return None
    result: dict[str, str] = {}
    for item in items:
        if not isinstance(item.get("name"), str):
            continue
        domain = str(item.get("domain", ""))
        if not domain.lstrip(".").endswith("antwerpen.be"):
            continue
        expires = item.get("expirationDate")
        if item.get("session") or not isinstance(expires, int | float):
            remaining = "browser session"
        else:
            remaining = f"{(expires - time.time()) / 3600:.1f} h left"
        result[f"{label(item['name'])} @ {domain}"] = remaining
    return result


def jar_lifetimes(session: aiohttp.ClientSession) -> dict[str, dict[str, str]]:
    """Lifetime attributes of every cookie the site set (no values)."""
    return {
        f"{label(m.key)} @ {m['domain'] or '(host)'}": {
            "max-age": m["max-age"] or "-",
            "expires": "set" if m["expires"] else "-",
        }
        for m in session.cookie_jar
    }


def show(title: str, value: Any) -> None:
    """Print a titled JSON block."""
    import json  # noqa: PLC0415

    print(f"\n== {title}")
    print(json.dumps(value, indent=2, ensure_ascii=False))


async def main() -> None:
    """Run the probe."""
    test_sso = "--sso" in sys.argv
    print("Paste your login data, then press Ctrl-D (Ctrl-Z Enter on Windows):", file=sys.stderr)
    text = sys.stdin.read()
    try:
        cookies = api.parse_login_data(text)
    except api.InvalidLoginDataError:
        sys.exit(
            "\nNo usable cookies found in what you pasted. Paste a 'Copy as cURL' of the saldo "
            "request, the Cookie header, or cookie-editor JSON export(s) of "
            "afvalcontainer.antwerpen.be / authentication.antwerpen.be."
        )
    show("cookies kept (names only)", sorted(label(n) for n in cookies))
    if (lifetimes := pasted_lifetimes(text)) is not None:
        show("cookie lifetimes in the export", lifetimes)

    async with aiohttp.ClientSession(cookie_jar=aiohttp.CookieJar()) as session:
        client = api.AfvalcontainerClient(session, cookies)
        try:
            data = await client.async_get_balance(allow_sso=False)
        except api.NotLoggedInError as err:
            show("balance page", {"logged_in": False, "reason": str(err)})
            data = None
        else:
            show(
                "balance page",
                {
                    "logged_in": True,
                    "inertia_version_found": bool(client.inertia_version),
                    "history_rows": len(data.history),
                    "service_labels": sorted({r.service_label or "-" for r in data.history}),
                    "containers": len(data.containers),
                    "has_account_id": data.account.account_id is not None,
                    "has_first_name": data.account.first_name is not None,
                },
            )
            page = await client._async_get_page(api.BALANCE_PATH, api.BALANCE_COMPONENT)  # noqa: SLF001
            show("balance props shape", shape(page.get("props"), max_depth=3))
            show("cookies set by the site (lifetimes only)", jar_lifetimes(session))

            overview: dict[str, Any] = {}
            for path in ("/mijn-containers", api.CONTAINERS_PATH):
                try:
                    other = await client._async_get_page(path, None)  # noqa: SLF001
                except api.AfvalcontainerError as err:
                    show(path, {"error": type(err).__name__})
                else:
                    show(f"{path} ({other.get('component')})", shape(other.get("props")))
                    overview = other

            for index, address_id in enumerate(api.linked_address_ids(overview), 1):
                path = f"{api.CONTAINERS_PATH}/{address_id}"
                title = f"{api.CONTAINERS_PATH}/<address {index}>"
                try:
                    detail = await client._async_get_page(path, None)  # noqa: SLF001
                except api.AfvalcontainerError as err:
                    show(title, {"error": type(err).__name__})
                    continue
                show(
                    f"{title} ({detail.get('component')})", shape(detail.get("props"), max_depth=6)
                )
                probe_data = api.parse_balance_page(page)
                api.enrich_containers(probe_data.containers, detail)
                show(
                    f"{title}: containers recognised",
                    {
                        f"container {n}": {
                            "number_found_on_page": info.fraction is not None
                            or info.volume is not None,
                            "fraction_found": info.fraction is not None,
                            "volume_found": info.volume is not None,
                        }
                        for n, info in enumerate(probe_data.containers.values(), 1)
                    },
                )

            try:
                url = f"{api.BASE_URL}{api.BALANCE_PATH}/export"
                async with session.get(url, headers={"User-Agent": api.USER_AGENT}) as resp:
                    body = await resp.read()
                    show(
                        "saldo/export",
                        {
                            "status": resp.status,
                            "final_path": resp.url.path,
                            "content_type": resp.content_type,
                            "content_disposition": bool(resp.headers.get("Content-Disposition")),
                            "bytes": len(body),
                            "starts_with": body[:8].hex(),
                        },
                    )
            except (aiohttp.ClientError, TimeoutError) as err:
                show("saldo/export", {"error": type(err).__name__})

        if test_sso:
            sso_only = {k: v for k, v in cookies.items() if k in api.SSO_COOKIES}
            show("SSO cookies available", sorted(sso_only))
            async with aiohttp.ClientSession(cookie_jar=aiohttp.CookieJar()) as fresh:
                sso_client = api.AfvalcontainerClient(fresh, sso_only)
                ok = await sso_client.async_try_sso()
                result: dict[str, Any] = {"sso_flow_returned_to_app": ok}
                if ok:
                    try:
                        await sso_client.async_get_balance(allow_sso=False)
                        result["balance_after_sso"] = "OK"
                    except api.AfvalcontainerError as err:
                        result["balance_after_sso"] = type(err).__name__
                show("silent SSO re-login (without the app session cookie)", result)


if __name__ == "__main__":
    asyncio.run(main())
